@page "/"
@inject AuthService Auth
@inject IExchangeRateService Rates
@inject ICryptoService CryptoSvc
@inject IFavoritesService Favs
@inject NavigationManager Nav

<PageTitle>Dashboard — Overdrive Exchange</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1>Good @_greet, @Auth.FullName?.Split(' ')[0] 👋</h1>
            <p class="page-sub">Market overview · @DateTime.Now.ToString("dddd, MMMM d")</p>
        </div>
        <div class="live-pill"><span class="live-dot"></span>LIVE</div>
    </div>

    @if (_loading)
    {
        <div class="loading-bar"><div class="loading-fill"></div></div>
        <p class="loading-msg">Fetching live rates…</p>
    }
    else
    {
        <!-- Stat cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">💱</div>
                <div class="stat-label">Currencies</div>
                <div class="stat-value">53</div>
                <div class="stat-sub">Tracked globally</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">₿</div>
                <div class="stat-label">Crypto</div>
                <div class="stat-value">5</div>
                <div class="stat-sub">Top by market cap</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">★</div>
                <div class="stat-label">Favorites</div>
                <div class="stat-value">@_favorites.Count</div>
                <div class="stat-sub">Your saved pairs</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🕐</div>
                <div class="stat-label">Last Update</div>
                <div class="stat-value" style="font-size:13px">@_updatedAt</div>
                <div class="stat-sub">Auto-refresh 10 min</div>
            </div>
        </div>

        <div class="dash-grid">
            <!-- Forex -->
            <div class="card">
                <div class="card-hdr">
                    <span class="section-label">🌍 Top Forex vs USD</span>
                    <a href="/converter" class="card-link">Convert →</a>
                </div>
                @foreach (var p in _forex)
                {
                    <div class="rate-row" @onclick='() => Nav.NavigateTo("/trends?from=" + p.BaseCurrency + "&to=" + p.TargetCurrency)'>
                        <div class="rate-flags">🇺🇸@p.TargetFlag</div>
                        <div class="rate-info">
                            <div class="rate-pair">@p.BaseCurrency / @p.TargetCurrency</div>
                            <div class="rate-name">@p.TargetName</div>
                        </div>
                        <Sparkline Data="@p.SparkData" Up="true" />
                        <div class="rate-vals">
                            <div class="rate-val">@p.Rate.ToString("F4")</div>
                            <div class="muted" style="font-size:11px">Live rate</div>
                        </div>
                        <button class="star-btn @(_favCodes.Contains(p.TargetCurrency) ? "starred" : "")"
                                @onclick:stopPropagation
                                @onclick="()=>ToggleFav(p.TargetCurrency, p.TargetName, p.TargetFlag)">★</button>
                    </div>
                }
            </div>

            <!-- Crypto (CoinGecko) -->
            <div class="card">
                <div class="card-hdr">
                    <span class="section-label">🪙 Crypto Markets</span>
                    <span class="card-note">24h change</span>
                </div>

                @if (_cryptoLoading)
                {
                    <div class="loading-bar" style="margin-top:16px"><div class="loading-fill"></div></div>
                }
                else if (!_crypto.Any())
                {
                    <div class="empty-state" style="padding:28px 16px">
                        <div class="empty-icon" style="font-size:32px">🔑</div>
                        <div class="empty-title">Add your CoinGecko API key</div>
                        <div class="empty-sub">Set <code>CoinGecko:ApiKey</code> in appsettings.json to enable live prices.</div>
                    </div>
                }
                else
                {
                    @foreach (var c in _crypto)
                    {
                        bool up = c.ChangePercent24h >= 0;
                        <div class="rate-row">
                            <div class="crypto-icon" style="background:@(c.Color)22;color:@c.Color">
                                @if (!string.IsNullOrEmpty(c.ImageUrl))
                                {
                                    <img src="@c.ImageUrl" alt="@c.Symbol" style="width:20px;height:20px;border-radius:50%" />
                                }
                                else
                                {
                                    @c.Icon
                                }
                            </div>
                            <div class="rate-info">
                                <div class="rate-pair">@c.Symbol / USD</div>
                                <div class="rate-name">@c.Name · $@c.MarketCapBillions.ToString("F0")B cap</div>
                            </div>
                            <div class="rate-vals">
                                <div class="rate-val">
                                    $@(c.PriceUsd >= 1
                                        ? c.PriceUsd.ToString("N2")
                                        : c.PriceUsd.ToString("N4"))
                                </div>
                                <div class="@(up ? "chg-up" : "chg-dn")">
                                    @(up ? "▲" : "▼")@Math.Abs(c.ChangePercent24h).ToString("F2")%
                                </div>
                            </div>
                        </div>
                    }
                }

                <!-- CoinGecko Attribution — required by their Terms of Service -->
                <div class="coingecko-attr">
                    <a href="https://www.coingecko.com/en/api" target="_blank" rel="noopener noreferrer">
                        <img src="https://static.coingecko.com/s/coingecko-logo-8903d34ce19ca4be1c81f0db30e924154750d2fad96afe655effa9a19a893933.png"
                             alt="CoinGecko" class="coingecko-logo" />
                    </a>
                    <span>Data powered by <a href="https://www.coingecko.com/en/api" target="_blank" rel="noopener noreferrer">CoinGecko</a></span>
                </div>
            </div>
        </div>

        <!-- Favorites strip -->
        @if (_favorites.Any())
        {
            <div class="card mt-4">
                <div class="card-hdr">
                    <span class="section-label">★ Your Favorites</span>
                    <a href="/favorites" class="card-link">Manage →</a>
                </div>
                <div class="fav-strip">
                    @foreach (var f in _favorites)
                    {
                        var rate = _liveRates.GetValueOrDefault(f.CurrencyCode, 0);
                        <div class="fav-chip" @onclick='() => Nav.NavigateTo("/trends?from=USD&to=" + f.CurrencyCode)'>
                            <span class="fav-flag">@f.Flag</span>
                            <span class="fav-code">@f.CurrencyCode</span>
                            <span class="fav-rate">@(rate > 0 ? rate.ToString("F4") : "…")</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private List<ForexRate>           _forex       = new();
    private List<CryptoRate>          _crypto      = new();
    private List<FavoriteCurrency>    _favorites   = new();
    private HashSet<string>           _favCodes    = new();
    private Dictionary<string,double> _liveRates   = new();
    private bool   _loading       = true;
    private bool   _cryptoLoading = true;
    private string _greet         = "day";
    private string _updatedAt     = "—";

    protected override async Task OnInitializedAsync()
    {
        _greet = DateTime.Now.Hour < 12 ? "morning" : DateTime.Now.Hour < 18 ? "afternoon" : "evening";

        // Load forex and favorites in parallel
        var forexTask = Rates.GetTopForexAsync();
        var favsTask  = Auth.UserId.HasValue
            ? Favs.GetAsync(Auth.UserId.Value)
            : Task.FromResult(new List<FavoriteCurrency>());

        await Task.WhenAll(forexTask, favsTask);

        _forex     = forexTask.Result;
        _favorites = favsTask.Result;
        _favCodes  = _favorites.Select(f => f.CurrencyCode).ToHashSet();

        foreach (var f in _favorites)
            _liveRates[f.CurrencyCode] = Math.Round(await Rates.GetRateAsync("USD", f.CurrencyCode), 4);

        _updatedAt = DateTime.Now.ToString("HH:mm");
        _loading   = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Load crypto separately so forex shows immediately
        _crypto        = await CryptoSvc.GetTopCryptoAsync();
        _cryptoLoading = false;
        StateHasChanged();
    }

    private async Task ToggleFav(string code, string name, string flag)
    {
        if (!Auth.UserId.HasValue) return;
        if (_favCodes.Contains(code))
        {
            await Favs.RemoveAsync(Auth.UserId.Value, code);
            _favCodes.Remove(code);
            _favorites.RemoveAll(f => f.CurrencyCode == code);
        }
        else
        {
            await Favs.AddAsync(Auth.UserId.Value, code, name, flag);
            _favCodes.Add(code);
            _favorites.Add(new FavoriteCurrency { CurrencyCode=code, CurrencyName=name, Flag=flag });
            _liveRates[code] = Math.Round(await Rates.GetRateAsync("USD", code), 4);
        }
    }
}
