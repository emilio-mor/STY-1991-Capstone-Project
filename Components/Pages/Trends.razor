@page "/trends"
@inject IExchangeRateService Rates

<PageTitle>Trends — Overdrive Exchange</PageTitle>

<div class="page">
    <div class="page-header">
        <div><h1>Currency Trends</h1><p class="page-sub">Live rate · simulated history around current price</p></div>
    </div>

    <div class="card mb-4">
        <div class="trend-selectors">
            <div class="form-group">
                <label class="conv-label">Base</label>
                <select class="fx-select" @bind="_from" @bind:after="Reload">
                    @foreach (var c in _currencies) { <option value="@c.Code">@c.Flag @c.Code – @c.Name</option> }
                </select>
            </div>
            <div class="vs-label">VS</div>
            <div class="form-group">
                <label class="conv-label">Target</label>
                <select class="fx-select" @bind="_to" @bind:after="Reload">
                    @foreach (var c in _currencies) { <option value="@c.Code">@c.Flag @c.Code – @c.Name</option> }
                </select>
            </div>
            <div class="form-group">
                <label class="conv-label">Period</label>
                <div class="period-btns">
                    @foreach (var d in new[] { 7,14,30,60,90 })
                    {
                        <button class="period-btn @(_days==d?"active":"")" @onclick="()=>SetDays(d)">@d d</button>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-bar"><div class="loading-fill"></div></div>
    }
    else if (_trend != null)
    {
        <div class="trend-stats">
            <div class="tstat-card"><div class="tstat-label">Live Rate</div><div class="tstat-val">@_trend.CurrentRate.ToString("F6")</div></div>
            <div class="tstat-card"><div class="tstat-label">@_days-Day Change</div>
                <div class="tstat-val @(_trend.ChangePercent>=0?"chg-up":"chg-dn")">@(_trend.ChangePercent>=0?"▲":"▼")@Math.Abs(_trend.ChangePercent).ToString("F2")%</div></div>
            <div class="tstat-card"><div class="tstat-label">Period High</div><div class="tstat-val chg-up">@_trend.High.ToString("F6")</div></div>
            <div class="tstat-card"><div class="tstat-label">Period Low</div><div class="tstat-val chg-dn">@_trend.Low.ToString("F6")</div></div>
        </div>

        <div class="card chart-card">
            <div class="chart-header">
                <div>
                    <div class="chart-title">@_trend.Pair</div>
                    <div class="chart-sub">@_trend.BaseFlag @_trend.BaseName → @_trend.TargetFlag @_trend.TargetName · Live rate anchored</div>
                </div>
                <div class="chg-badge @(_trend.ChangePercent>=0?"badge-up":"badge-dn")">
                    @(_trend.ChangePercent>=0?"▲":"▼") @Math.Abs(_trend.ChangePercent).ToString("F2")%
                </div>
            </div>
            <SvgLineChart Data="@_trend.History" Up="@(_trend.ChangePercent>=0)" />
        </div>

        <div class="card mt-4">
            <div class="section-label mb-3">Historical Data</div>
            <div class="hist-table-wrap">
                <table class="hist-table">
                    <thead><tr><th>Date</th><th>Rate (@_from → @_to)</th><th>Change</th></tr></thead>
                    <tbody>
                        @{ var rev = _trend.History.AsEnumerable().Reverse().ToList(); }
                        @for (int i = 0; i < rev.Count; i++)
                        {
                            var pt = rev[i]; var prev = i < rev.Count-1 ? rev[i+1].Rate : pt.Rate;
                            var chg = prev > 0 ? (pt.Rate - prev) / prev * 100 : 0;
                            <tr>
                                <td>@pt.Label</td>
                                <td class="mono">@pt.Rate.ToString("F6")</td>
                                <td class="@(i==rev.Count-1?"muted":chg>=0?"chg-up":"chg-dn")">
                                    @(i==rev.Count-1 ? "—" : $"{(chg>=0?"▲":"▼")} {Math.Abs(chg):F4}%")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name="from")] public string? FromParam { get; set; }
    [SupplyParameterFromQuery(Name="to")]   public string? ToParam   { get; set; }

    private List<CurrencyInfo> _currencies = new();
    private string       _from  = "USD";
    private string       _to    = "EUR";
    private int          _days  = 30;
    private bool         _loading;
    private TrendResult? _trend;

    protected override async Task OnInitializedAsync()
    {
        _currencies = Rates.GetAllCurrencies();
        if (!string.IsNullOrEmpty(FromParam)) _from = FromParam.ToUpper();
        if (!string.IsNullOrEmpty(ToParam))   _to   = ToParam.ToUpper();
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true; StateHasChanged();
        _trend   = await Rates.GetTrendAsync(_from, _to, _days);
        _loading = false;
    }

    private async Task SetDays(int d) { _days = d; await Reload(); }
}
