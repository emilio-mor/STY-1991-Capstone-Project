@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav

@* If already logged in, go straight to dashboard *@
@if (Auth.IsAuth)
{
    Nav.NavigateTo("/", replace: true);
    return;
}

<div class="auth-page">
    <div class="auth-orb auth-orb-1"></div>
    <div class="auth-orb auth-orb-2"></div>

    <div class="auth-card">
        <!-- Logo -->
        <div class="auth-logo">
            <div class="auth-logo-badge">OX</div>
            <div>
                <div class="auth-logo-title">Overdrive <span>Exchange</span></div>
                <div class="auth-logo-sub">Real-time Exchange Intelligence</div>
            </div>
        </div>

        <!-- Tab switcher -->
        <div class="auth-tabs">
            <button class="auth-tab @(_mode=="login"?"active":"")"    @onclick='()=>SwitchMode("login")'>Sign In</button>
            <button class="auth-tab @(_mode=="register"?"active":"")" @onclick='()=>SwitchMode("register")'>Register</button>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-error @(_error.StartsWith("✓")?"auth-success":"")">
                @(_error.StartsWith("✓") ? "" : "⚠ ")@_error
            </div>
        }

        @if (_mode == "login")
        {
            <form method="post" action="/login-handler">
                <input type="hidden" name="returnUrl" value="/" />

                <div class="form-group">
                    <label>Email or Username</label>
                    <input name="emailOrUsername" class="form-input"
                           placeholder="you@example.com" autocomplete="username" required />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input name="password" type="password" class="form-input"
                           placeholder="••••••••" autocomplete="current-password" required />
                </div>

                <div class="form-check">
                    <input type="checkbox" name="rememberMe" value="true" id="rem" />
                    <label for="rem">Remember me for 30 days</label>
                </div>

                <button type="submit" class="auth-btn">Sign In →</button>
            </form>

            <div class="demo-hint">
                Demo: <span>demo</span> / <span>demo123</span>
            </div>
        }

        @if (_mode == "register")
        {
            <EditForm Model="_register" OnValidSubmit="DoRegister">
                <DataAnnotationsValidator />

                <div class="form-row-2">
                    <div class="form-group">
                        <label>Full Name</label>
                        <InputText @bind-Value="_register.FullName" class="form-input" placeholder="John Doe" />
                        <ValidationMessage For="()=>_register.FullName" class="field-err" />
                    </div>
                    <div class="form-group">
                        <label>Username</label>
                        <InputText @bind-Value="_register.Username" class="form-input" placeholder="johndoe" />
                        <ValidationMessage For="()=>_register.Username" class="field-err" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <InputText @bind-Value="_register.Email" class="form-input" placeholder="you@example.com" />
                    <ValidationMessage For="()=>_register.Email" class="field-err" />
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label>Password</label>
                        <InputText @bind-Value="_register.Password" type="password"
                                   class="form-input" placeholder="Min 6 chars" />
                        <ValidationMessage For="()=>_register.Password" class="field-err" />
                    </div>
                    <div class="form-group">
                        <label>Confirm Password</label>
                        <InputText @bind-Value="_register.ConfirmPassword" type="password"
                                   class="form-input" placeholder="••••••••" />
                        <ValidationMessage For="()=>_register.ConfirmPassword" class="field-err" />
                    </div>
                </div>

                <button type="submit" class="auth-btn" disabled="@_busy">
                    @(_busy ? "Creating account…" : "Create Account →")
                </button>
            </EditForm>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private string        _mode     = "login";
    private string        _error    = "";
    private bool          _busy;
    private RegisterModel _register = new();

    protected override void OnParametersSet()
    {
        if (Error == "invalid")
            _error = "Invalid credentials. Try demo / demo123";
    }

    private void SwitchMode(string m) { _mode = m; _error = ""; }

    private async Task DoRegister()
    {
        _busy = true; _error = "";
        var (ok, err, _) = await Auth.RegisterAsync(_register);
        if (!ok) { _error = err; _busy = false; return; }
        _mode     = "login";
        _register = new();
        _busy     = false;
        _error    = "✓ Account created! Please sign in below.";
    }
}
