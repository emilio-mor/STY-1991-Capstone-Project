@model ExchangeRateApp.Models.TrendData?
@{
    ViewData["Title"] = "Currency Trends";
    var allCurrencies = ViewBag.AllCurrencies as List<ExchangeRateApp.Models.CurrencyInfo> ?? new();
    var selBase = ViewBag.SelectedBase as string ?? "USD";
    var selTarget = ViewBag.SelectedTarget as string ?? "EUR";
    var selDays = ViewBag.SelectedDays as int? ?? 30;
}

<div class="page-header">
    <div>
        <h1>Currency Trends</h1>
        <p class="page-sub">Historical exchange rate charts and analysis</p>
    </div>
</div>

<!-- Pair Selector -->
<div class="card trend-selector">
    <form method="get" asp-action="Index" id="trendForm" class="trend-form">
        <div class="trend-form-grid">
            <div class="form-group">
                <label>Base Currency</label>
                <select name="base" class="currency-select" onchange="this.form.submit()">
                    @foreach (var c in allCurrencies)
                    {
                        <option value="@c.Code" @(c.Code == selBase ? "selected" : "")>@c.Flag @c.Code – @c.Name</option>
                    }
                </select>
            </div>
            <div class="trend-vs">VS</div>
            <div class="form-group">
                <label>Target Currency</label>
                <select name="target" class="currency-select" onchange="this.form.submit()">
                    @foreach (var c in allCurrencies)
                    {
                        <option value="@c.Code" @(c.Code == selTarget ? "selected" : "")>@c.Flag @c.Code – @c.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Period</label>
                <select name="days" class="currency-select" onchange="this.form.submit()">
                    <option value="7" @(selDays == 7 ? "selected":"")>7 Days</option>
                    <option value="14" @(selDays == 14 ? "selected":"")>14 Days</option>
                    <option value="30" @(selDays == 30 ? "selected":"")>30 Days</option>
                    <option value="60" @(selDays == 60 ? "selected":"")>60 Days</option>
                    <option value="90" @(selDays == 90 ? "selected":"")>90 Days</option>
                </select>
            </div>
        </div>
    </form>
</div>

@if (Model != null)
{
    <!-- Stats cards -->
    <div class="trend-stats">
        <div class="trend-stat-card">
            <div class="tsc-label">Current Rate</div>
            <div class="tsc-value">@Model.CurrentRate.ToString("N6")</div>
            <div class="tsc-sub">@Model.BaseFlag @Model.BaseName → @Model.TargetFlag @Model.TargetName</div>
        </div>
        <div class="trend-stat-card">
            <div class="tsc-label">@selDays-Day Change</div>
            <div class="tsc-value @(Model.ChangePercent >= 0 ? "up" : "down")">
                @(Model.ChangePercent >= 0 ? "▲" : "▼") @Math.Abs(Model.ChangePercent).ToString("F2")%
            </div>
            <div class="tsc-sub">From @Model.History.FirstOrDefault()?.Rate.ToString("N6")</div>
        </div>
        <div class="trend-stat-card">
            <div class="tsc-label">Period High</div>
            <div class="tsc-value up">@Model.High.ToString("N6")</div>
            <div class="tsc-sub">Best rate in period</div>
        </div>
        <div class="trend-stat-card">
            <div class="tsc-label">Period Low</div>
            <div class="tsc-value down">@Model.Low.ToString("N6")</div>
            <div class="tsc-sub">Worst rate in period</div>
        </div>
    </div>

    <!-- Chart -->
    <div class="card chart-card">
        <div class="chart-header">
            <div>
                <div class="chart-title">@selBase / @selTarget</div>
                <div class="chart-sub">@Model.BaseFlag @Model.BaseName to @Model.TargetFlag @Model.TargetName · @selDays days</div>
            </div>
            <div class="chart-badge @(Model.ChangePercent >= 0 ? "badge-up" : "badge-down")">
                @(Model.ChangePercent >= 0 ? "▲" : "▼") @Math.Abs(Model.ChangePercent).ToString("F2")%
            </div>
        </div>
        <canvas id="trendChart" height="100"></canvas>
    </div>

    <!-- Trend table -->
    <div class="card mt-20">
        <div class="section-title">Historical Data</div>
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Rate (@selBase → @selTarget)</th>
                        <th>Change</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = Model.History.Count - 1; i >= 0; i--)
                    {
                        var pt = Model.History[i];
                        var prev = i > 0 ? Model.History[i - 1].Rate : pt.Rate;
                        var chg = (pt.Rate - prev) / prev * 100;
                        <tr>
                            <td>@pt.Date.ToString("MMM dd, yyyy")</td>
                            <td class="mono">@pt.Rate.ToString("N6")</td>
                            <td class="@(chg >= 0 ? "up" : "down")">
                                @(i == 0 ? "—" : $"{(chg >= 0 ? "▲" : "▼")} {Math.Abs(chg):F4}%")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
@if (Model != null)
{
    <script>
    const historyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.History.Select(h => new { date = h.Date.ToString("MMM dd"), rate = Math.Round(h.Rate, 6) })
    ));
    const isUp = @(Model.ChangePercent >= 0 ? "true" : "false");
    const color = isUp ? '#00e5b4' : '#ff4d6d';

    new Chart(document.getElementById('trendChart'), {
        type: 'line',
        data: {
            labels: historyData.map(d => d.date),
            datasets: [{
                label: '@selBase/@selTarget',
                data: historyData.map(d => d.rate),
                borderColor: color,
                backgroundColor: color + '18',
                borderWidth: 2,
                pointRadius: 3,
                pointHoverRadius: 6,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0d1220',
                    borderColor: color,
                    borderWidth: 1,
                    titleColor: '#e8eaf6',
                    bodyColor: color,
                    callbacks: {
                        label: ctx => `  Rate: ${ctx.parsed.y.toFixed(6)}`
                    }
                }
            },
            scales: {
                x: {
                    grid: { color: 'rgba(255,255,255,0.04)' },
                    ticks: { color: '#5a6282', maxTicksLimit: 8 }
                },
                y: {
                    grid: { color: 'rgba(255,255,255,0.04)' },
                    ticks: { color: '#5a6282', callback: v => v.toFixed(4) }
                }
            }
        }
    });
    </script>
}
}
